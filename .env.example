# ==============================================================================
# DREAM-TO-DOOM — Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY & ARCHITECTURE RULES:
# 1. GEMINI_API_KEY is strictly server-side only (used in Vercel Serverless Functions /api).
# 2. NEVER prefix backend secrets with VITE_ (e.g. NEVER use VITE_GEMINI_API_KEY),
#    as any VITE_ variable is baked directly into public client JavaScript bundles!
# 3. Copy this file to .env.local for local development. Never commit real credentials.
# 4. In production, configure secrets in your Vercel Project Settings > Environment Variables.
# ==============================================================================

# Serverless Gemini AI Configuration (Used in /api/generate-world.ts)
GEMINI_API_KEY=your_secret_gemini_api_key_here

# Configurable Model Identifier (Default: gemini-3.8-flash for speed & structured outputs)
GEMINI_MODEL=gemini-3.8-flash
